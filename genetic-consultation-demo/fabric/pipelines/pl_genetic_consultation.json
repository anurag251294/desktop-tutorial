{
  "properties": {
    "description": "Genetic consultation demo: ClinVar reference ingestion, typed variant reference with a field-quality gate, synthetic case assessment, and the agent evidence contract.",
    "activities": [
      {
        "name": "Bronze_ClinVar_Reference",
        "type": "TridentNotebook",
        "description": "Pull germline variant records for the configured gene panel from the public NCBI ClinVar API.",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "{{NOTEBOOK_ID:bronze_clinvar_reference}}",
          "workspaceId": "{{WORKSPACE_ID}}",
          "parameters": {
            "PANEL_NAME": {
              "value": { "value": "@pipeline().parameters.PANEL_NAME", "type": "Expression" },
              "type": "string"
            },
            "GENES": {
              "value": { "value": "@pipeline().parameters.GENES", "type": "Expression" },
              "type": "string"
            },
            "MAX_PER_GENE": {
              "value": { "value": "@pipeline().parameters.MAX_PER_GENE", "type": "Expression" },
              "type": "int"
            },
            "PIPELINE_RUN_ID": {
              "value": { "value": "@pipeline().RunId", "type": "Expression" },
              "type": "string"
            }
          }
        }
      },
      {
        "name": "Silver_Variant_Reference",
        "type": "TridentNotebook",
        "description": "Flatten to one typed row per variant and enforce the populated-rate gate on every citable field.",
        "dependsOn": [
          { "activity": "Bronze_ClinVar_Reference", "dependencyConditions": ["Succeeded"] }
        ],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "{{NOTEBOOK_ID:silver_variant_reference}}",
          "workspaceId": "{{WORKSPACE_ID}}",
          "parameters": {
            "PIPELINE_RUN_ID": {
              "value": { "value": "@pipeline().RunId", "type": "Expression" },
              "type": "string"
            }
          }
        }
      },
      {
        "name": "Gold_Case_Assessment",
        "type": "TridentNotebook",
        "description": "Assess synthetic cases against the reference, keeping classified, no-entry and not-covered structurally distinct.",
        "dependsOn": [
          { "activity": "Silver_Variant_Reference", "dependencyConditions": ["Succeeded"] }
        ],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "{{NOTEBOOK_ID:gold_case_assessment}}",
          "workspaceId": "{{WORKSPACE_ID}}",
          "parameters": {
            "PIPELINE_RUN_ID": {
              "value": { "value": "@pipeline().RunId", "type": "Expression" },
              "type": "string"
            }
          }
        }
      },
      {
        "name": "Publish_Evidence_Contract",
        "type": "TridentNotebook",
        "description": "Package each case into a validated evidence envelope. Fails closed if gold and envelope disagree.",
        "dependsOn": [
          { "activity": "Gold_Case_Assessment", "dependencyConditions": ["Succeeded"] }
        ],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "{{NOTEBOOK_ID:agent_handoff_publisher}}",
          "workspaceId": "{{WORKSPACE_ID}}",
          "parameters": {
            "PIPELINE_RUN_ID": {
              "value": { "value": "@pipeline().RunId", "type": "Expression" },
              "type": "string"
            }
          }
        }
      }
    ],
    "parameters": {
      "PANEL_NAME": { "type": "String", "defaultValue": "childhood_epilepsy_v1" },
      "GENES": {
        "type": "String",
        "defaultValue": "SCN1A,SCN2A,KCNQ2,STXBP1,CDKL5,MECP2,PCDH19,DEPDC5"
      },
      "MAX_PER_GENE": { "type": "Int", "defaultValue": 120 }
    }
  }
}
