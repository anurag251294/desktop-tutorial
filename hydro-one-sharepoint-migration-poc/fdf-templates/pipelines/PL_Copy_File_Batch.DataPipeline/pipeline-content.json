                                                                                                                                                                                           "value":  "@concat(pipeline().parameters.DestPathPrefix, if(contains(item(), \u0027parentReference\u0027), replace(replace(item().parentReference.path, concat(\u0027/drives/\u0027, pipeline().parameters.DriveId, \u0027/root:\u0027), \u0027\u0027), concat(\u0027/drives/\u0027, pipeline().parameters.DriveId, \u0027/root\u0027), \u0027\u0027), \u0027\u0027), \u0027/\u0027, item().name)",
                                                                                                                                                                                           "type":  "Expression"
                                                                                                                                                                                       },
                                                                                                                                                                             "type":  "String"
                                                                                                                                                                         },
                                                                                                                                                     "FileSizeBytes":  {
                                                                                                                                                                           "value":  {
                                                                                                                                                                                         "value":  "@item().size",
                                                                                                                                                                                         "type":  "Expression"
                                                                                                                                                                                     },
                                                                                                                                                                           "type":  "Int64"
                                                                                                                                                                       },
                                                                                                                                                     "MigrationStatus":  {
                                                                                                                                                                             "value":  {
                                                                                                                                                                                           "value":  "@pipeline().parameters.MigrationStatus",
                                                                                                                                                                                           "type":  "Expression"
                                                                                                                                                                                       },
                                                                                                                                                                             "type":  "String"
                                                                                                                                                                         },
                                                                                                                                                     "PipelineRunId":  {
                                                                                                                                                                           "value":  {
                                                                                                                                                                                         "value":  "@pipeline().parameters.ParentRunId",
                                                                                                                                                                                         "type":  "Expression"
                                                                                                                                                                                     },
                                                                                                                                                                           "type":  "String"
                                                                                                                                                                       },
                                                                                                                                                     "ErrorDetails":  {
                                                                                                                                                                          "value":  null,
                                                                                                                                                                          "type":  "String"
                                                                                                                                                                      }
                                                                                                                                                 }
                                                                                                               },
                                                                                            "linkedServiceName":  {
                                                                                                                      "referenceName":  "LS_AzureSqlDatabase",
                                                                                                                      "type":  "LinkedServiceReference"
                                                                                                                  }
                                                                                        },
                                                                                        {
