{
    "properties":  {
                       "description":  "Lightweight child pipeline that copies a batch of files from Graph API to ADLS Gen2. Called by parent pipelines via ExecutePipeline to work around ADF\u0027s restriction on ForEach inside Until loops.",
                       "activities":  [
                                          {
                                              "name":  "ForEach_CopyFile",
                                              "description":  "Iterate over the file items array and copy each file. Handles empty arrays gracefully (0 iterations).",
                                              "type":  "ForEach",
                                              "dependsOn":  [

                                                            ],
                                              "userProperties":  [

                                                                 ],
                                              "typeProperties":  {
                                                                     "items":  {
                                                                                   "value":  "@pipeline().parameters.FileItems",
                                                                                   "type":  "Expression"
                                                                               },
                                                                     "isSequential":  false,
                                                                     "batchCount":  10,
                                                                     "activities":  [
                                                                                        {
                                                                                            "name":  "Copy_File",
                                                                                            "type":  "Copy",
                                                                                            "dependsOn":  [

                                                                                                          ],
                                                                                            "policy":  {
                                                                                                           "timeout":  "0.01:00:00",
                                                                                                           "retry":  5,
                                                                                                           "retryIntervalInSeconds":  60,
                                                                                                           "secureOutput":  false,
                                                                                                           "secureInput":  false
                                                                                                       },
                                                                                            "userProperties":  [

                                                                                                               ],
                                                                                            "typeProperties":  {
                                                                                                                   "source":  {
                                                                                                                                  "type":  "BinarySource",
                                                                                                                                  "storeSettings":  {
                                                                                                                                                        "type":  "HttpReadSettings",
                                                                                                                                                        "requestMethod":  "GET",
                                                                                                                                                        "additionalHeaders":  {
                                                                                                                                                                                  "value":  "@concat(\u0027Authorization: Bearer \u0027, pipeline().parameters.AccessToken)",
                                                                                                                                                                                  "type":  "Expression"
                                                                                                                                                                              },
                                                                                                                                                        "requestTimeout":  "00:30:00"
                                                                                                                                                    },
                                                                                                                                  "formatSettings":  {
                                                                                                                                                         "type":  "BinaryReadSettings"
                                                                                                                                                     },
                                                                                                                                  "datasetSettings":  {
                                                                                                                                                          "description":  "Binary dataset for downloading files via Graph API /content endpoint. Uses item ID to construct download path.",
                                                                                                                                                          "linkedServiceName":  {
                                                                                                                                                                                    "referenceName":  "LS_HTTP_Graph_Download",
                                                                                                                                                                                    "type":  "LinkedServiceReference",
                                                                                                                                                                                    "parameters":  {

                                                                                                                                                                                                   }
                                                                                                                                                                                },
                                                                                                                                                          "annotations":  [
                                                                                                                                                                              "graph-api",
                                                                                                                                                                              "binary",
                                                                                                                                                                              "download",
                                                                                                                                                                              "hydro-one-migration"
                                                                                                                                                                          ],
                                                                                                                                                          "type":  "Binary",
                                                                                                                                                          "typeProperties":  {
                                                                                                                                                                                 "location":  {
                                                                                                                                                                                                  "type":  "HttpServerLocation",
                                                                                                                                                                                                  "relativeUrl":  {
                                                                                                                                                                                                                      "value":  "@concat(\u0027/v1.0/drives/\u0027, pipeline().parameters.DriveId, \u0027/items/\u0027, item().id, \u0027/content\u0027)",
                                                                                                                                                                                                                      "type":  "Expression"
                                                                                                                                                                                                                  }
                                                                                                                                                                                              }
                                                                                                                                                                             }
                                                                                                                                                      }
                                                                                                                              },
                                                                                                                   "sink":  {
                                                                                                                                "type":  "BinarySink",
                                                                                                                                "storeSettings":  {
                                                                                                                                                      "type":  "AzureBlobFSWriteSettings"
                                                                                                                                                  },
                                                                                                                                "datasetSettings":  {
                                                                                                                                                        "description":  "Binary dataset for storing migrated files in ADLS Gen2. Preserves original folder structure from SharePoint.",
                                                                                                                                                        "linkedServiceName":  {
                                                                                                                                                                                  "referenceName":  "LS_ADLS_Gen2",
                                                                                                                                                                                  "type":  "LinkedServiceReference"
                                                                                                                                                                              },
                                                                                                                                                        "annotations":  [
                                                                                                                                                                            "adls",
                                                                                                                                                                            "sink",
                                                                                                                                                                            "binary",
                                                                                                                                                                            "hydro-one-migration"
                                                                                                                                                                        ],
                                                                                                                                                        "type":  "Binary",
                                                                                                                                                        "typeProperties":  {
                                                                                                                                                                               "location":  {
                                                                                                                                                                                                "type":  "AzureBlobFSLocation",
                                                                                                                                                                                                "fileName":  {
                                                                                                                                                                                                                 "value":  "@item().name",
                                                                                                                                                                                                                 "type":  "Expression"
                                                                                                                                                                                                             },
                                                                                                                                                                                                "folderPath":  {
                                                                                                                                                                                                                   "value":  "@concat(dataset().SiteName, \u0027/\u0027, dataset().LibraryName, if(empty(dataset().FolderPath), \u0027\u0027, concat(\u0027/\u0027, dataset().FolderPath)))",
                                                                                                                                                                                                                   "type":  "Expression"
                                                                                                                                                                                                               },
                                                                                                                                                                                                "fileSystem":  {
                                                                                                                                                                                                                   "value":  "@pipeline().parameters.ContainerName",
                                                                                                                                                                                                                   "type":  "Expression"
                                                                                                                                                                                                               }
                                                                                                                                                                                            }
                                                                                                                                                                           }
                                                                                                                                                    }
                                                                                                                            },
                                                                                                                   "enableStaging":  false
                                                                                                               }
                                                                                        },
                                                                                        {
                                                                                            "name":  "Log_Success",
