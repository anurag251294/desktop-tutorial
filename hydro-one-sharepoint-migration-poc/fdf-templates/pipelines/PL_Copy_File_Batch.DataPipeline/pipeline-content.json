                                                                                                                                                     "SourcePath":  {
                                                                                                                                                                        "value":  {
                                                                                                                                                                                      "value":  "@concat(pipeline().parameters.SourcePathPrefix, if(contains(item(), \u0027parentReference\u0027), replace(replace(item().parentReference.path, concat(\u0027/drives/\u0027, pipeline().parameters.DriveId, \u0027/root:\u0027), \u0027\u0027), concat(\u0027/drives/\u0027, pipeline().parameters.DriveId, \u0027/root\u0027), \u0027\u0027), \u0027\u0027), \u0027/\u0027, item().name)",
                                                                                                                                                                                      "type":  "Expression"
                                                                                                                                                                                  },
                                                                                                                                                                        "type":  "String"
                                                                                                                                                                    },
                                                                                                                                                     "DestinationPath":  {
