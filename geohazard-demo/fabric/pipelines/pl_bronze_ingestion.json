{
  "properties": {
    "description": "Geohazard end-to-end medallion orchestration for a user-selected latitude, longitude, and radius: ingest Planetary Computer STAC metadata, BC DataBC surficial geology, and BC soil survey in parallel; build the bronze overview maps; then run the silver soil-susceptibility model and the gold RF-1 risk matrix in sequence.",
    "parameters": {
      "LATITUDE": {
        "type": "Float",
        "defaultValue": 49.2193
      },
      "LONGITUDE": {
        "type": "Float",
        "defaultValue": -122.5984
      },
      "RADIUS_KM": {
        "type": "Int",
        "defaultValue": 20
      },
      "ANALYSIS_RADIUS_KM": {
        "type": "Float",
        "defaultValue": 3.0
      }
    },
    "activities": [
      {
        "name": "Ingest_PC_Collections",
        "type": "TridentNotebook",
        "description": "Bronze ingestion of Microsoft Planetary Computer STAC collections for the selected AOI.",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "{{NOTEBOOK_ID:bronze_pc_collections}}",
          "workspaceId": "{{WORKSPACE_ID}}",
          "parameters": {
            "LATITUDE": {
              "value": {
                "value": "@pipeline().parameters.LATITUDE",
                "type": "Expression"
              },
              "type": "float"
            },
            "LONGITUDE": {
              "value": {
                "value": "@pipeline().parameters.LONGITUDE",
                "type": "Expression"
              },
              "type": "float"
            },
            "RADIUS_KM": {
              "value": {
                "value": "@pipeline().parameters.RADIUS_KM",
                "type": "Expression"
              },
              "type": "int"
            }
          }
        }
      },
      {
        "name": "Ingest_Planetary",
        "type": "TridentNotebook",
        "description": "Bronze ingestion of Planetary Computer satellite STAC items (bronze_satellite_stac_items) for the selected AOI.",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "{{NOTEBOOK_ID:bronze_planetary_ingestion}}",
          "workspaceId": "{{WORKSPACE_ID}}",
          "parameters": {
            "LATITUDE": {
              "value": {
                "value": "@pipeline().parameters.LATITUDE",
                "type": "Expression"
