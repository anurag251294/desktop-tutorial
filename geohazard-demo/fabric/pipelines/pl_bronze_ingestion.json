            },
            "LONGITUDE": {
              "value": {
                "value": "@pipeline().parameters.LONGITUDE",
                "type": "Expression"
              },
              "type": "float"
            },
            "RADIUS_KM": {
              "value": {
                "value": "@pipeline().parameters.RADIUS_KM",
                "type": "Expression"
              },
              "type": "int"
            }
          }
        }
      },
      {
        "name": "Ingest_BC_Geology",
        "type": "TridentNotebook",
        "description": "Bronze ingestion of BC DataBC WFS geology layers (quaternary, bedrock, faults) for the selected AOI.",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
