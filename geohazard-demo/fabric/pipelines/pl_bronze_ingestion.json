        "name": "Ingest_BC_Soil_Survey",
        "type": "TridentNotebook",
        "description": "Bronze ingestion of BC soil survey polygons and project boundaries (bronze_bc_soil_survey_polygons, bronze_bc_soil_project_boundaries) for the selected AOI.",
        "dependsOn": [],
