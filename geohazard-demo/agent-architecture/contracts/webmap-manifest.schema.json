{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/geohazard/contracts/webmap-manifest.schema.json",
  "title": "Geohazard Web Map Manifest",
  "description": "Run-specific deterministic map sources, viewport, legends, and provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "generatedAtUtc", "viewport", "layers", "legends"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "viewport": {
      "$ref": "#/$defs/viewport"
    },
    "layers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "legends": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/legend"
      }
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "bounds", "zoom"],
      "properties": {
        "center": {
          "$ref": "#/$defs/position"
        },
        "bounds": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/position"
            },
            {
              "$ref": "#/$defs/position"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "zoom": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "role",
        "sourceType",
        "uri",
        "defaultVisible",
        "opacity",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["basemap", "aoi", "risk", "hotspot", "soil", "geology", "fault", "stac"]
        },
        "sourceType": {
          "type": "string",
          "enum": ["geojson", "rasterTiles", "vectorTiles", "imageOverlay"]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "defaultVisible": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "legendId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "featureIdProperty": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceTable", "generatedAtUtc", "queryHash"],
      "properties": {
        "sourceTable": {
          "type": "string",
          "minLength": 1
        },
        "generatedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "queryHash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "legend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "items"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label", "color"],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            }
          }
        }
      }
    }
  }
}