{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/geohazard/contracts/geohazard-report-input.schema.json",
  "title": "Geohazard Report Input",
  "description": "Versioned deterministic evidence supplied to the Foundry report agent for one completed pipeline run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "run",
    "aoi",
    "method",
    "sourceCoverage",
    "riskSummary",
    "riskMatrix",
    "hotspots",
    "limitations",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "pipelineName", "status", "completedAtUtc"],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "pipelineName": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "Completed"
        },
        "completedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "aoi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude",
        "bronzeRadiusKm",
        "analysisRadiusKm",
        "analysisCrs",
        "resolutionM"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -80,
          "maximum": 84
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "bronzeRadiusKm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "analysisRadiusKm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        },
        "analysisCrs": {
          "type": "string",
          "pattern": "^EPSG:(326|327)[0-9]{2}$"
        },
        "resolutionM": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["riskFactor", "formula", "bandDefinitions"],
      "properties": {
        "riskFactor": {
          "const": "RF-1"
        },
        "formula": {
          "const": "risk_score = s_rating * c_rating"
        },
        "bandDefinitions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/bandDefinition"
          }
        }
      }
    },
    "sourceCoverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceCoverage"
      }
    },
    "riskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalPixels", "totalAreaKm2", "bands"],
      "properties": {
        "totalPixels": {
          "type": "integer",
          "minimum": 1
        },
        "totalAreaKm2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/bandSummary"
          }
        }
      }
    },
    "riskMatrix": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/matrixCell"
      }
    },
    "hotspots": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/hotspot"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "webmapManifestUri": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "riskBand": {
      "type": "string",
      "enum": ["Low", "Moderate", "High", "Extreme"]
    },
    "bandDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "minimumScore", "maximumScore"],
      "properties": {
        "band": {
          "$ref": "#/$defs/riskBand"
        },
        "minimumScore": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "maximumScore": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        }
      }
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "sourceName", "tableName", "status", "recordCount"],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/evidenceId"
        },
        "sourceName": {
          "type": "string",
          "minLength": 1
        },
        "tableName": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["available", "empty", "error", "unavailable"]
        },
        "recordCount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    },
    "bandSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "band", "pixelCount", "areaKm2", "pct"],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/evidenceId"
        },
        "band": {
          "$ref": "#/$defs/riskBand"
        },
        "pixelCount": {
          "type": "integer",
          "minimum": 0
        },
        "areaKm2": {
          "type": "number",
          "minimum": 0
        },
        "pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "matrixCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "sRating", "cRating", "riskScore", "riskBand", "pixelCount"],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/evidenceId"
        },
        "sRating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "cRating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "riskScore": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "riskBand": {
          "$ref": "#/$defs/riskBand"
        },
        "pixelCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hotspot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "featureId",
        "rank",
        "latitude",
        "longitude",
        "sRating",
        "cRating",
        "riskScore",
        "riskBand"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/evidenceId"
        },
        "featureId": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "sRating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "cRating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "riskScore": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "riskBand": {
          "$ref": "#/$defs/riskBand"
        }
      }
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^E[1-9][0-9]*$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "sourceTable", "retrievedAtUtc", "values"],
      "properties": {
        "id": {
          "$ref": "#/$defs/evidenceId"
        },
        "kind": {
          "type": "string",
          "enum": ["run", "aoi", "sourceCoverage", "bandSummary", "riskMatrix", "hotspot", "limitation"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sourceTable": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string"
        },
        "retrievedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "values": {
          "type": "object"
        }
      }
    }
  }
}